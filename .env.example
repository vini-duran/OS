# Modelo portátil sem credenciais. O ContentFlow usa estes valores na Central de Plugins/Keychain.
# Nunca preencha este arquivo versionado; copie para .env apenas quando uma ferramenta local exigir.

OPENAI_API_KEY=
YOUTUBE_DATA_API_KEYS=
PEXELS_API_KEYS=
PIXABAY_API_KEYS=
OPENVERSE_CLIENTS_JSON=

# Formatos:
# YOUTUBE_DATA_API_KEYS=chave1,chave2,...,chave8
# PEXELS_API_KEYS=chave1,chave2,...,chave8
# PIXABAY_API_KEYS=chave1,chave2,...,chave8
# OPENVERSE_CLIENTS_JSON=[{"client_id":"...","client_secret":"..."}]
