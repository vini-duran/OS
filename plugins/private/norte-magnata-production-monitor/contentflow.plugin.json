{
  "$schema": "../../../docs/schemas/contentflow-plugin-v1.schema.json",
  "apiVersion": "1",
  "id": "com.norte-magnata.production-monitor",
  "name": "Norte Magnata — Monitor de produção",
  "version": "0.1.0",
  "description": "Mostra no ContentFlow o estado de geração Flow/Dola, materialização, handoff e edição do Norte Magnata.",
  "author": "Norte Magnata",
  "license": "LicenseRef-Norte-Magnata-Internal",
  "runtime": { "kind": "node", "version": ">=24 <27", "module": "esm" },
  "entrypoint": "handler.mjs",
  "permissions": ["filesystem:read"],
  "deliveryTypes": ["processing"],
  "capabilities": [
    {
      "id": "read-production-state",
      "operator": "Código",
      "blockTypes": ["BUSCAR"],
      "processTypes": ["editing"],
      "inputPorts": [],
      "outputPorts": [
        {
          "key": "production_state",
          "label": "Estado da produção",
          "producedTypes": ["records"],
          "required": true,
          "presentation": { "renderer": "table", "itemType": "record" }
        },
        {
          "key": "production_summary",
          "label": "Resumo operacional",
          "producedTypes": ["textarea"],
          "required": true,
          "presentation": { "renderer": "text-long" }
        }
      ],
      "execution": {
        "mode": "immediate",
        "defaultTimeoutMs": 15000,
        "supportsCancellation": true,
        "maxConcurrency": 1
      },
      "sideEffects": [],
      "cost": { "model": "free", "estimateSupported": true },
      "dataPolicy": { "sendsDataToThirdParties": false },
      "blockConfigSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": { "type": "object" }
    }
  ]
}
